##############################################################################
# TrainerSync Microservices — Environment Variables
# Copy this file to .env and fill in all secrets before running docker-compose.
# Lines beginning with # are comments and are NOT loaded.
##############################################################################

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://host.docker.internal:27017
MONGODB_DB_NAME=trainersync

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-string

# ── CORS (comma-separated frontend origins) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Gmail / SMTP ──────────────────────────────────────────────────────────────
# Either use Gmail OAuth (token.json) OR App Password — not both.
GMAIL_USER=sujithaofficial585@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
FROM_NAME=Clahan Technologies
FROM_EMAIL=sujithaofficial585@gmail.com
# Path inside the email-service contai  \  ner where token.json is mounted
GOOGLE_TOKEN_FILE=config/token.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
STYLE_IMAP_HOST=imap.hostinger.com
STYLE_IMAP_PORT=993
STYLE_IMAP_USER=your-clahan-hostinger-mailbox@example.com
STYLE_IMAP_PASSWORD=ROTATE_AND_FILL_HOSTINGER_PASSWORD
STYLE_IMAP_FOLDER=INBOX.Sent

# ── AI / LLM Keys ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=z-ai/glm-5.2[im]
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BINARY=ollama
OLLAMA_SONNET_MODEL=claude-sonnet-4-20250514

# OpenAI mail generation. Keep the real key only in .env; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional: set only when using an OpenAI-compatible provider such as Bedrock Mantle.
OPENAI_API_BASE=
USE_OPENAI_FOR_EMAILS=false
USE_LLM_FOR_EMAILS=false

# Auto-send remains off until safe email categories have been tested.
AUTO_SEND_ENABLED=false
AUTO_SEND_CONFIDENCE_THRESHOLD=0.85
# Comma-separated inbound topics that must never be auto-sent.
AUTO_SEND_RISK_KEYWORDS=price,pricing,payment,invoice,discount,quote,quotation,contract,agreement,legal,complaint,refund,cancel,cancellation,terminate,termination

# Leave blank normally. Set an ISO-8601 timestamp after clearing the inbox
# database to import only messages received from that time onward.
INBOX_PROCESS_AFTER=

# ── LinkedIn OAuth — optional login support ───────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── WhatsApp — choose ONE provider —──────────────────────────────────────────
# Provider options: twilio | aisensy | meta
WHATSAPP_PROVIDER=twilio
DEFAULT_COUNTRY_CODE=+91
VENDOR_WHATSAPP_NUMBER=+919999999999

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# AiSensy
AISENSY_API_KEY=your_aisensy_api_key
AISENSY_CAMPAIGN_NAME=trainersync_campaign
AISENSY_SOURCE=TrainerSync
AISENSY_TEMPLATE_PARAM_FIELDS=message
AISENSY_TAGS=trainersync

# Meta / WhatsApp Cloud API
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_access_token
META_WHATSAPP_TEMPLATE_NAME=trainer_first_contact
META_WHATSAPP_LANGUAGE_CODE=en_US
META_GRAPH_API_VERSION=v23.0

# ── Microsoft Teams ───────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── Frontend URL (used for shortlist links in Teams cards) ────────────────────
FRONTEND_URL=http://localhost:3000

# ── Internal service-to-service URLs ─────────────────────────────────────────
# These default to Docker service names — only override for non-Docker setups.
EMAIL_SERVICE_URL=http://email-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003

# ── Scheduler ─────────────────────────────────────────────────────────────────
INTERVIEW_REMINDER_HOURS_BEFORE=1

# ── LinkedIn / Search (optional) ──────────────────────────────────────────────
PROXYCURL_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.dev
TAVILY_SEARCH_DEPTH=basic
# Optional unattended Google Meet host bot. Keep disabled until a dedicated
# Google account has been authenticated in the persistent browser profile.
MEET_BOT_ENABLED=false
MEET_BOT_JOIN_MINUTES_BEFORE=3
MEET_BOT_DEFAULT_DURATION_MINUTES=60
MEET_BOT_LEAVE_MINUTES_AFTER=10
MEET_BOT_AUTO_ADMIT=false
MEET_BOT_HEADLESS=false
MEET_BOT_POLL_SECONDS=20
MEET_BOT_HEALTH_PORT=8010
MEET_BOT_ALLOWED_HOSTS=meet.google.com
MEET_BOT_MAX_ATTEMPTS=3
