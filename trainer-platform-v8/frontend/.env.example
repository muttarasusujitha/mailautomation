# Frontend environment variables for TrainerSync
# Use a Google OAuth client ID from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=255969810791-h01bm69lh1x...apps.googleusercontent.com
# Optional: LinkedIn OAuth client configuration for sign-in
VITE_LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
VITE_LINKEDIN_REDIRECT_URI=https://localhost:5174/auth/linkedin/callback
VITE_LINKEDIN_SCOPES=r_liteprofile r_emailaddress
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5174
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://ts-gateway
VITE_CORE_API_PROXY_TARGET=http://ts-gateway
VITE_EMAIL_SERVICE_PROXY_TARGET=http://ts-gateway
VITE_TRAINER_SERVICE_PROXY_TARGET=http://ts-gateway
